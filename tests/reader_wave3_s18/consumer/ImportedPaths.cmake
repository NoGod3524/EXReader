# Resolve the installed reading-state include indirection; every other expression
# is refused rather than omitted from the install-prefix proof.
function(s18_imported_paths output target property trail)
  if(NOT TARGET "${target}" OR NOT target MATCHES "^EXReader")
    message(FATAL_ERROR "Unknown imported path target: ${target}")
  endif()
  get_target_property(imported "${target}" IMPORTED)
  if(NOT imported)
    message(FATAL_ERROR "Non-imported path target: ${target}")
  endif()
  set(key "${target}|${property}")
  if(key IN_LIST trail)
    message(FATAL_ERROR "Cyclic imported path expression: ${key}")
  endif()
  list(APPEND trail "${key}")
  get_target_property(values "${target}" "${property}")
  set(resolved "")
  if(values)
    foreach(value IN LISTS values)
      string(FIND "${value}" "$<" expression)
      if(expression EQUAL -1)
        list(APPEND resolved "${value}")
      elseif(value MATCHES "^\\$<TARGET_PROPERTY:([^,<>]+),INTERFACE_INCLUDE_DIRECTORIES>$")
        set(reference "${CMAKE_MATCH_1}")
        if(NOT reference MATCHES "^EXReader::")
          message(FATAL_ERROR "Unknown imported path reference: ${reference}")
        endif()
        set_property(GLOBAL APPEND PROPERTY S18_IMPORTED_PATH_EXPRESSIONS
          "${target}|${property}|${value}|${reference}")
        s18_imported_paths(nested "${reference}" INTERFACE_INCLUDE_DIRECTORIES "${trail}")
        list(APPEND resolved ${nested})
      else()
        message(FATAL_ERROR "Unsupported imported path expression: ${target} ${property} ${value}")
      endif()
    endforeach()
  endif()
  set(${output} "${resolved}" PARENT_SCOPE)
endfunction()

function(s18_owned_path output target property path)
  if(NOT IS_ABSOLUTE "${path}")
    message(FATAL_ERROR "Unresolved imported path: ${target} ${property} ${path}")
  endif()
  file(REAL_PATH "${path}" actual)
  set(owned FALSE)
  foreach(prefix FAMILY_PREFIX SHARED_PREFIX SDK_PREFIX)
    file(REAL_PATH "${${prefix}}" allowed)
    cmake_path(IS_PREFIX allowed "${actual}" NORMALIZE matches)
    if(matches)
      set(owned TRUE)
    endif()
  endforeach()
  if(NOT owned OR NOT EXISTS "${path}")
    message(FATAL_ERROR "Foreign imported path: ${target} ${property} ${actual}")
  endif()
  set(${output} "${actual}" PARENT_SCOPE)
endfunction()
