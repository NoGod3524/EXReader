  "scaling": [
    {
      "id": "dynamic-type-scales",
      "from": "reader.epub",
      "to": "reader.large_type",
      "platforms": [
        "iphone",
        "ipad"
      ],
      "ids": [
        "reader.location",
        "reader.progress",
        "reader.status",
        "reader.title"
      ],
      "min_growth_pt": 0.5,
      "blocking": true,
      "severity": "major",
      "expected": "系统文本样式（.caption/.headline）随内容尺寸类别放大",
      "fix": "若高度不增长，说明固定 frame/lineLimit 压制了缩放：改为可换行布局或按 @ScaledMetric 决定行高"
    }
  ],
  "content_rules": [
    {
      "id": "reader-state-internal-hash",
      "state": "reader.epub",
      "element": "reader.state",
      "field": "label",
      "forbid_regex": "^#[0-9A-Za-z]{4,}$",
      "severity": "minor",
      "blocking": false,
      "expected": "辅助技术只应读到用户可理解的状态，而不是内部状态哈希",
      "note": "HostViews.swift:226 把 model.stateHash 直接渲染为 #<hash> 并暴露为 reader.state",
      "fix": "生产构建隐藏该调试行，或对其加 .accessibilityHidden(true)"
    },
    {
      "id": "font-button-symbol-only",
      "state": "reader.epub",
      "element": "reader.font.decrease",
      "field": "label",
      "forbid_regex": "^A[-+±]$",
      "severity": "major",
      "blocking": false,
      "expected": "字号按钮有语义名称（增大/减小字号）",
      "note": "HostViews.swift:242/246 用 A-/A+ 作为唯一按钮文本",
      "fix": "补 .accessibilityLabel(\"减小字号\")/\"增大字号\""
    },
    {
      "id": "library-title-trace",
      "state": "library.empty",
      "element": "library.title",
      "field": "value",
      "forbid_substring": "token=",
      "severity": "minor",
      "blocking": false,
      "expected": "AX value 不应暴露内部 UI 测试追踪串",
      "note": "HostViews.swift:73 把 model.uiTestTrace 作为 library.title 的 accessibilityValue",
      "fix": "仅在 -EXRUITestFixtures 下挂载该调试值，或加 .accessibilityHidden(true)"
    },
    {
      "id": "library-book-index-identifier",
      "state": "library.populated",
      "element": "library.book.0",
      "field": "id",
      "warn_regex": "^library\\.book\\.\\d+$",
      "severity": "minor",
      "blocking": false,
      "expected": "书架行标识应稳定（按记录 id），而不是按枚举下标",
      "note": "HostViews.swift:111 用 ForEach 的 index 生成 library.book.<index>",
      "fix": "改用 library.book.<bookID>；同时保留 AX 名称中的书名以便人工脚本稳定"
    }
  ],
  "keyboard": {
    "platforms": [
      "macos"
    ],
    "blocking": true,
    "probe": "16 次 Tab，每第 4 次追加 Space；每次按键后采样可观察状态（位置/字号/状态/面板出现）",
    "expected": "macOS 全键盘访问下，Tab/Space 能驱动阅读器，可观察状态必须出现变化",
    "fix": "若 16 次按键完全无状态变化：为控制栏补 .focusable()/keyboardShortcut，或把 HStack 包进 .focusSection()",
    "partial_severity": "major",
    "focus_order": {
      "verdict": "uncovered",
      "reason": "本次 Xcode 的 XCUIElement 没有 hasFocus/焦点 API，逐控件焦点顺序不可观察；需全键盘访问人工走查"
    }
  },
  "feature_gaps": [
    {
