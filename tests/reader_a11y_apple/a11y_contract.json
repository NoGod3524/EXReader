  "schema": 1,
  "package": "G16 Apple accessibility audit",
  "source_citation": "examples/apple/HostViews.swift @ f43baf9182d75907c0cb5d6f77048f27bca8c950",
  "role_names": "XCUITest elementType names (Button, StaticText, TextField, TextView, ScrollView, Other)",
  "policy": {
    "blocking_rule": "a finding blocks accessibility only when its criterion is part of the audited accessibility contract and the contract marks it blocking",
    "audit_vs_acceptance": "audit_completed reports whether the three targets produced the declared evidence; accessibility_accepted reports whether that evidence violated a blocking criterion",
    "minimum_target_pt": {
      "blocking": 24,
      "blocking_platforms": [
        "iphone",
        "ipad"
      ],
      "advisory_ios": 44,
      "advisory_macos": 20,
      "note": "WCAG 2.5.8 的 24 pt 下限按触控平台阻断；macOS 原生控件按指针平台惯例只做 20 pt 建议项，避免用 Web 门槛误判 AppKit 控件"
    },
    "clip_tolerance_pt": 2,
    "reading_order_tolerance_pt": 20,
    "overlap_scope": [
      "容器一律由已记录的语义路径推导；几何不参与判断父子关系。",
      "两侧都没有滚动祖先：直接比较布局框，按 50% 阈值判遮挡（同级完全包含、同尺寸重合、面积 20% 的小控件被全覆盖都算遮挡）。",
      "同一有标识的滚动容器且视口已记录：用该共享视口裁剪两侧后按同一 50% 阈值判。",
      "不同滚动容器：各自用最近已记录视口裁剪后按同一阈值判。",
      "只有语义路径证明一方是另一方的实际祖先（路径 token 为对方前缀）时才豁免嵌套遮挡；不按面积猜父子。",
      "滚动祖先缺少标识、或视口未出现在该步骤语义树、或视口框为空：记 uncovered（overlap-undetermined），不把 raw 几何当作已测可见遮挡，也不声称已被裁剪。",
      "排除（overlap-scroll-clipped）只在视口已记录且裁剪后可视部分不相交时成立，并留下对数与配对数。"
    ],
    "overlap_threshold": 0.5
  },
