# Opt in with -DCMAKE_PROJECT_INCLUDE=<absolute-path>/tests/table_history_l03.cmake.
function(exr_l03_history_test)
  if(NOT EXR_BUILD_TESTS OR NOT TARGET exreader OR TARGET exreader-table-history-l03)
    return()
  endif()
  add_executable(exreader-table-history-l03 "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/test_table_history_l03.c")
  target_link_libraries(exreader-table-history-l03 PRIVATE exreader)
  target_compile_definitions(exreader-table-history-l03 PRIVATE EXR_STATIC)
  if(MSVC)
    target_compile_options(exreader-table-history-l03 PRIVATE /UNDEBUG)
  else()
    target_compile_options(exreader-table-history-l03 PRIVATE -UNDEBUG)
  endif()
  add_test(NAME native-table-history-l03 COMMAND exreader-table-history-l03)
endfunction()
cmake_language(DEFER CALL exr_l03_history_test)
