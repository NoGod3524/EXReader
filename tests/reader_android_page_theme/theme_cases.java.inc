            ReadingCapture highlight=NativeReadingSdk.capture(store,live,begin,end,fontBytesForTheme(),live.layoutFont,originalPath(live.bookId),task(),control());
            NativeReadingSdk.Match a=NativeReadingSdk.resolve(store,live.bookId,bookmark,fontBytesForTheme(),live.layoutFont,task(),control()),b=NativeReadingSdk.resolve(store,live.bookId,highlight,fontBytesForTheme(),live.layoutFont,task(),control());
            need(a.found()&&b.found()&&a.start==begin&&b.start==begin&&b.end==end,"actual bookmark/highlight selectors independently FOUND at same visible themed glyph offsets");
            need(bookmark.parser.equals("exreader-sdk-3.41.0")&&highlight.parser.equals(bookmark.parser),"actual Android parser identity retained");
            String visible=ReflowSession.slice(live.text,begin-live.textBase,end-live.textBase);need(visible.equals(highlight.text(0)),"actual accepted frame text is exact captured highlight quote");
