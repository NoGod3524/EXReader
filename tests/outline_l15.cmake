# Opt in with -DCMAKE_PROJECT_INCLUDE=<absolute-path>/tests/outline_l15.cmake.
if(NOT WIN32 OR NOT CMAKE_CURRENT_SOURCE_DIR STREQUAL CMAKE_SOURCE_DIR)
  return()
endif()
enable_language(CXX)
function(exr_l15_outline_tests)
  if(NOT TARGET exreader OR TARGET check_shell_docedit_outline)
    return()
  endif()
  enable_testing()
  set(host "${CMAKE_SOURCE_DIR}/examples/windows")
  set(host_sources "${host}/shell_d2d.cpp" "${host}/shell_epub.cpp" "${host}/shell_speech.cpp")
  add_executable(check_shell_docedit_outline "${host}/check_shell_docedit_outline.c" ${host_sources})
  add_executable(check_shell_docedit "${host}/check_shell_docedit.c" ${host_sources})
  add_executable(check_shell_table "${host}/check_shell_table.c" ${host_sources})
  add_executable(EXReaderL15 WIN32 "${CMAKE_SOURCE_DIR}/examples/reader.c" ${host_sources})
  foreach(target check_shell_docedit_outline check_shell_docedit check_shell_table EXReaderL15)
    target_compile_definitions(${target} PRIVATE EXR_READER_WINDOWS_SHELL=1)
    target_compile_features(${target} PRIVATE c_std_11 cxx_std_17)
    target_link_libraries(${target} PRIVATE exreader miniz expat comdlg32 comctl32 gdi32
      uiautomationcore shell32 user32 winhttp crypt32 d2d1 dwrite advapi32 ole32 oleaut32 uuid)
    if(MSVC)
      target_compile_options(${target} PRIVATE /UNDEBUG /utf-8)
    else()
      target_compile_options(${target} PRIVATE -UNDEBUG)
      target_link_options(${target} PRIVATE -static)
      target_link_libraries(${target} PRIVATE m)
    endif()
  endforeach()
  add_test(NAME windows-docedit-outline-headless COMMAND check_shell_docedit_outline)
  add_test(NAME windows-docedit-headless COMMAND check_shell_docedit
    "${CMAKE_SOURCE_DIR}/tests/fixtures/rich.docx" "${CMAKE_BINARY_DIR}/docedit-evidence")
  add_test(NAME windows-table-headless COMMAND check_shell_table
    "${CMAKE_BINARY_DIR}/table-evidence" "${CMAKE_SOURCE_DIR}/tests/fixtures/rich.docx")
  set_tests_properties(windows-docedit-outline-headless windows-docedit-headless windows-table-headless
    PROPERTIES LABELS headless TIMEOUT 90)
endfunction()
cmake_language(DEFER CALL exr_l15_outline_tests)
