# One source inventory is shared with the compiled-symbol dependency check.
file(GLOB exr_public_headers CONFIGURE_DEPENDS "${CMAKE_CURRENT_SOURCE_DIR}/include/exr/*.h")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS ${exr_public_headers})
file(READ "${CMAKE_CURRENT_SOURCE_DIR}/tools/layers.json" exr_manifest)
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${CMAKE_CURRENT_SOURCE_DIR}/tools/layers.json")
string(JSON exr_source_count LENGTH "${exr_manifest}" files)
math(EXPR exr_source_last "${exr_source_count}-1")
foreach(i RANGE ${exr_source_last})
  string(JSON source MEMBER "${exr_manifest}" files ${i})
  string(JSON layer GET "${exr_manifest}" files "${source}")
  list(APPEND exr_sources_${layer} "src/${source}")
endforeach()
set(exr_layers base graphics text doc formats layout render)
if(EXR_ENABLE_PDF)
  list(APPEND exr_layers pdf)
endif()
if(EXR_ENABLE_PDF_EDIT)
  list(APPEND exr_layers pdf_edit)
endif()
if(EXR_ENABLE_AUDIO)
  list(APPEND exr_layers audio)
endif()
if(EXR_ENABLE_LIBRARY)
  list(APPEND exr_layers library)
endif()
if(EXR_BUILD_TEXT_INDEX)
  list(APPEND exr_layers textindex)
endif()
set(EXR_COMPONENT_TARGETS exr_core)
set(exr_objects)
foreach(layer IN LISTS exr_layers)
  add_library(exr_${layer}_objects OBJECT ${exr_sources_${layer}})
  target_compile_definitions(exr_${layer}_objects PRIVATE EXR_STATIC)
  target_include_directories(exr_${layer}_objects PRIVATE include)
  add_library(exr_${layer} STATIC $<TARGET_OBJECTS:exr_${layer}_objects>)
  add_library(EXReader::exr_${layer} ALIAS exr_${layer})
  target_compile_definitions(exr_${layer} INTERFACE EXR_STATIC)
  target_include_directories(exr_${layer} PUBLIC $<BUILD_INTERFACE:${CMAKE_CURRENT_SOURCE_DIR}/include> $<INSTALL_INTERFACE:include>)
  string(TOUPPER "${layer}" upper)
  if(DEFINED EXR_${upper}_VERSION)
    set(component_version "${EXR_${upper}_VERSION}")
  else()
    set(component_version "${EXR_CORE_VERSION}")
  endif()
  set_target_properties(exr_${layer} PROPERTIES VERSION "${component_version}" EXR_COMPONENT_VERSION "${component_version}" EXPORT_PROPERTIES EXR_COMPONENT_VERSION)
  if(MSVC)
    target_compile_options(exr_${layer}_objects PRIVATE /W4)
  else()
    target_compile_options(exr_${layer}_objects PRIVATE -Wall -Wextra -Wpedantic -Werror)
    target_link_libraries(exr_${layer} PUBLIC m)
  endif()
  list(APPEND EXR_COMPONENT_TARGETS exr_${layer})
  list(APPEND exr_objects $<TARGET_OBJECTS:exr_${layer}_objects>)
endforeach()
foreach(layer IN LISTS exr_layers)
  string(JSON count LENGTH "${exr_manifest}" layers "${layer}")
  if(count GREATER 0)
    math(EXPR last "${count}-1")
    foreach(i RANGE ${last})
      string(JSON dependency GET "${exr_manifest}" layers "${layer}" ${i})
      if(TARGET exr_${dependency})
        target_link_libraries(exr_${layer} PUBLIC exr_${dependency})
      endif()
    endforeach()
  endif()
endforeach()
add_library(exr_core INTERFACE)
add_library(EXReader::exr_core ALIAS exr_core)
target_link_libraries(exr_core INTERFACE exr_render)
set_target_properties(exr_core PROPERTIES EXR_COMPONENT_VERSION "${EXR_CORE_VERSION}" EXPORT_PROPERTIES EXR_COMPONENT_VERSION)

# Private dependency archives are installed separately. Their headers never form
# part of the public SDK, and are only needed while compiling these objects.
function(exr_private_dependency layer vendor)
  target_link_libraries(exr_${layer}_objects PRIVATE ${vendor})
  target_link_libraries(exr_${layer} PRIVATE $<BUILD_INTERFACE:${vendor}> $<INSTALL_INTERFACE:EXReader::vendor_${vendor}>)
  set_property(GLOBAL APPEND PROPERTY EXR_VENDOR_TARGETS ${vendor})
endfunction()
# A codec is commonly several upstream static libraries. Group them so the
# installed package can reconstruct one private link interface.
function(exr_vendor_group name)
  add_library(${name} INTERFACE)
  target_link_libraries(${name} INTERFACE ${ARGN})
  set_target_properties(${name} PROPERTIES EXR_VENDOR_FILES "${ARGN}")
endfunction()
exr_private_dependency(base miniz)
exr_private_dependency(doc expat)
exr_private_dependency(graphics miniz)
exr_private_dependency(text freetype)
exr_private_dependency(text miniz)
