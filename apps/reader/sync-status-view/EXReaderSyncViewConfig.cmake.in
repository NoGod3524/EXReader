@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
find_dependency(EXReaderSession @EXR_SESSION_VERSION@ EXACT CONFIG)
include("${CMAKE_CURRENT_LIST_DIR}/EXReaderSyncViewTargets.cmake")

foreach(_raw_target EXReaderSession::reader_session EXReaderSyncView::reader_sync_view)
  get_target_property(_raw_dependency_defs ${_raw_target} INTERFACE_COMPILE_DEFINITIONS)
  if(@EXR_READER_SELECTOR_BYTES_CANDIDATE@)
    if(NOT "EXR_READER_SELECTOR_BYTES_CANDIDATE=1" IN_LIST _raw_dependency_defs)
      message(FATAL_ERROR "Exact imported target belongs to the legacy capability family")
    endif()
  else()
    if("EXR_READER_SELECTOR_BYTES_CANDIDATE=1" IN_LIST _raw_dependency_defs)
      message(FATAL_ERROR "Legacy imported target cannot be replaced by a raw candidate")
    endif()
  endif()
endforeach()

# RAW-CANDIDATE ORIGIN GUARD: append-only; never changes imported targets.
if(@EXR_READER_SELECTOR_BYTES_CANDIDATE@)
  _exr_raw_guard_target(EXReaderSession::reader_session "${EXReaderSession_DIR}"
    reader_session.h READER_SESSION_VERSION 0.2.0 TRUE)
  _exr_raw_guard_target(EXReaderSyncView::reader_sync_view "${CMAKE_CURRENT_LIST_DIR}"
    reader_sync_view.h READER_SYNC_VIEW_VERSION 0.2.0 TRUE)
endif()
