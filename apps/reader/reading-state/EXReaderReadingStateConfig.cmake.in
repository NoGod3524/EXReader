@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
find_dependency(EXReaderRevisions @EXR_REVISIONS_VERSION@ EXACT CONFIG)
find_dependency(EXReader @EXR_SDK_VERSION@ EXACT CONFIG COMPONENTS core library)
include("${CMAKE_CURRENT_LIST_DIR}/EXReaderReadingStateTargets.cmake")

# RAW-CANDIDATE ORIGIN GUARD: append-only; never changes imported targets.
if(@EXR_READER_SELECTOR_BYTES_CANDIDATE@)
  _exr_raw_guard_target(EXReaderRevisions::reader_revisions "${EXReaderRevisions_DIR}"
    reader_revisions.h READER_REVISIONS_VERSION 0.4.0 TRUE)
  foreach(_sdk_target EXReader::exr_core EXReader::exr_library)
    _exr_raw_guard_target("${_sdk_target}" "${EXReader_DIR}" exr/base.h EXR_VERSION @EXR_SDK_VERSION@ FALSE)
  endforeach()
  if(TARGET EXReader::exreader)
    _exr_raw_guard_target(EXReader::exreader "${EXReader_DIR}" exr/base.h EXR_VERSION @EXR_SDK_VERSION@ FALSE)
  endif()
  _exr_raw_guard_target(EXReaderReadingState::reader_reading_state_codec "${CMAKE_CURRENT_LIST_DIR}"
    reader_reading_state.h READER_READING_STATE_VERSION 0.2.0 TRUE)
  _exr_raw_guard_target(EXReaderReadingState::reader_reading_state "${CMAKE_CURRENT_LIST_DIR}"
    reader_reading_state.h READER_READING_STATE_VERSION 0.2.0 FALSE)
endif()

if(@EXR_READER_SELECTOR_BYTES_CANDIDATE@)
  _exr_public_boundary_guard(EXReaderRevisions::reader_revisions "${EXReaderRevisions_DIR}"
    reader_selector_bytes_v1.h READER_REV_SELECTOR_BYTES_API_VERSION EXR_READER_PUBLIC_SELECTOR_BYTES_V1)
  _exr_public_boundary_guard(EXReaderReadingState::reader_reading_state_codec "${CMAKE_CURRENT_LIST_DIR}"
    reader_reading_state_retained_raw_v1.h READER_RS_RETAINED_RAW_API_VERSION EXR_READER_PUBLIC_RETAINED_RAW_V1)
endif()
