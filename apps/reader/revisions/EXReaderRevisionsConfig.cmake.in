@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
find_dependency(EXReaderProductCatalog 0.1.0 EXACT CONFIG)
include("${CMAKE_CURRENT_LIST_DIR}/EXReaderRevisionsTargets.cmake")

# RAW-CANDIDATE ORIGIN GUARD: append-only; never changes imported targets.
if(@EXR_READER_SELECTOR_BYTES_CANDIDATE@)
  function(_exr_raw_guard_target target config_dir header macro version raw)
    if(NOT TARGET "${target}")
      message(FATAL_ERROR "Raw candidate missing target: ${target}")
    endif()

    get_target_property(_type "${target}" TYPE)
    if(_type STREQUAL "INTERFACE_LIBRARY")
      # SDK core and the no-shared compatibility aggregate are interfaces.
      get_target_property(_links "${target}" INTERFACE_LINK_LIBRARIES)
      if("${target}" STREQUAL "EXReader::exr_core")
        if(NOT "EXReader::exr_render" IN_LIST _links)
          message(FATAL_ERROR "Raw candidate SDK core dependency mismatch")
        endif()
        set(_concretes EXReader::exr_base EXReader::exr_render)
      elseif("${target}" STREQUAL "EXReader::exreader")
        set(_concretes)
        foreach(_link IN LISTS _links)
          if(_link MATCHES "^EXReader::exr_")
            list(APPEND _concretes "${_link}")
          else()
            message(FATAL_ERROR "Raw candidate SDK aggregate dependency mismatch")
          endif()
        endforeach()
        if(NOT "EXReader::exr_core" IN_LIST _concretes OR NOT "EXReader::exr_library" IN_LIST _concretes)
          message(FATAL_ERROR "Raw candidate SDK aggregate lacks core/library")
        endif()
      else()
        message(FATAL_ERROR "Raw candidate unsupported interface target: ${target}")
      endif()
      foreach(_concrete IN LISTS _concretes)
        _exr_raw_guard_target("${_concrete}" "${config_dir}" "${header}" "${macro}" "${version}" FALSE)
      endforeach()
      return()
    endif()
    if(raw)
      get_target_property(_defs "${target}" INTERFACE_COMPILE_DEFINITIONS)
      if(NOT "EXR_READER_SELECTOR_BYTES_CANDIDATE=1" IN_LIST _defs)
        message(FATAL_ERROR "Raw candidate target belongs to the legacy capability family: ${target}")
      endif()
    endif()
    file(REAL_PATH "${config_dir}/../../.." _prefix)
    get_target_property(_includes "${target}" INTERFACE_INCLUDE_DIRECTORIES)
    set(_header_found FALSE)
    foreach(_include IN LISTS _includes)
      if(EXISTS "${_include}/${header}")
        file(REAL_PATH "${_include}/${header}" _header)
        cmake_path(IS_PREFIX _prefix "${_header}" NORMALIZE _inside)
        if(NOT _inside)
          message(FATAL_ERROR "Raw candidate header origin mismatch: ${target}")
        endif()
        file(READ "${_header}" _text)
        string(FIND "${_text}" "#define ${macro} \"${version}\"" _version)
        if(_version EQUAL -1)
          message(FATAL_ERROR "Raw candidate header version mismatch: ${target}")
        endif()
        set(_header_found TRUE)
      endif()
    endforeach()
    if(NOT _header_found)
      message(FATAL_ERROR "Raw candidate public header missing: ${target}")
    endif()
    get_target_property(_configs "${target}" IMPORTED_CONFIGURATIONS)
    set(_properties IMPORTED_LOCATION)
    foreach(_config IN LISTS _configs)
      string(TOUPPER "${_config}" _config)
      list(APPEND _properties "IMPORTED_LOCATION_${_config}")
    endforeach()
    set(_archive_found FALSE)
    foreach(_property IN LISTS _properties)
      get_target_property(_location "${target}" "${_property}")
      if(_location)
        file(REAL_PATH "${_location}" _archive)
        cmake_path(IS_PREFIX _prefix "${_archive}" NORMALIZE _inside)
        if(NOT _inside OR NOT EXISTS "${_archive}")
          message(FATAL_ERROR "Raw candidate archive origin mismatch: ${target}")
        endif()
        set(_archive_found TRUE)
      endif()
    endforeach()
    if(NOT _archive_found)
      message(FATAL_ERROR "Raw candidate imported archive missing: ${target}")
    endif()
  endfunction()
  _exr_raw_guard_target(EXReaderRevisions::reader_revisions "${CMAKE_CURRENT_LIST_DIR}"
    reader_revisions.h READER_REVISIONS_VERSION 0.4.0 TRUE)
endif()

# Public boundary API versions are independent of the package/raw-store version.
if(@EXR_READER_SELECTOR_BYTES_CANDIDATE@)
  function(_exr_public_boundary_guard target config_dir header macro capability)
    _exr_raw_guard_target("${target}" "${config_dir}" "${header}" "${macro}" 1.0.0 TRUE)
    get_target_property(_public_type "${target}" TYPE)
    if(NOT _public_type STREQUAL "STATIC_LIBRARY")
      message(FATAL_ERROR "Public boundary owner is not a static archive: ${target}")
    endif()
    string(REGEX REPLACE "^.*::" "" _public_name "${target}")
    set(_public_archive_name "${CMAKE_STATIC_LIBRARY_PREFIX}${_public_name}${CMAKE_STATIC_LIBRARY_SUFFIX}")
    get_target_property(_public_configs "${target}" IMPORTED_CONFIGURATIONS)
    set(_public_locations IMPORTED_LOCATION)
    foreach(_config IN LISTS _public_configs)
      string(TOUPPER "${_config}" _config)
      list(APPEND _public_locations "IMPORTED_LOCATION_${_config}")
    endforeach()
    foreach(_property IN LISTS _public_locations)
      get_target_property(_public_location "${target}" "${_property}")
      if(_public_location)
        get_filename_component(_public_archive "${_public_location}" NAME)
        if(NOT _public_archive STREQUAL _public_archive_name)
          message(FATAL_ERROR "Public boundary target redirected to another archive: ${target}")
        endif()
      endif()
    endforeach()
    get_target_property(_public_defs "${target}" INTERFACE_COMPILE_DEFINITIONS)
    set(_public_count 0)
    foreach(_definition IN LISTS _public_defs)
      string(FIND "${_definition}" "${capability}" _mentions)
      if(NOT _mentions EQUAL -1)
        if(NOT _definition STREQUAL "${capability}=1")
          message(FATAL_ERROR "Conflicting public boundary capability: ${_definition}")
        endif()
        math(EXPR _public_count "${_public_count}+1")
      endif()
    endforeach()
    if(NOT _public_count EQUAL 1)
      message(FATAL_ERROR "Public boundary requires exactly one capability: ${target}/${capability}")
    endif()
    get_target_property(_public_includes "${target}" INTERFACE_INCLUDE_DIRECTORIES)
    foreach(_include IN LISTS _public_includes)
      if(EXISTS "${_include}/${header}")
        file(READ "${_include}/${header}" _public_text)
        # The existing raw-family guard is unchanged. New API proof removes
        # comments, then requires one comment-stripped literal definition, not a substring.
        string(REGEX REPLACE "/\\*([^*]|\\*+[^*/])*\\*+/" "" _public_text "${_public_text}")
        string(REGEX REPLACE "//[^\n]*" "" _public_text "${_public_text}")
        string(REGEX MATCHALL "(^|\n)[ \t]*#[ \t]*define[ \t]+${macro}([ \t]+[^\n]*)?" _public_versions "${_public_text}")
        list(LENGTH _public_versions _public_version_count)
        if(NOT _public_version_count EQUAL 1)
          message(FATAL_ERROR "Public boundary needs one literal API version: ${header}")
        endif()
        list(GET _public_versions 0 _public_version)
        string(STRIP "${_public_version}" _public_version)
        if(NOT _public_version MATCHES "^#[ \t]*define[ \t]+${macro}[ \t]+\"1\\.0\\.0\"[ \t]*$")
          message(FATAL_ERROR "Public boundary API version mismatch: ${header}")
        endif()
      endif()
    endforeach()
  endfunction()
  _exr_public_boundary_guard(EXReaderRevisions::reader_revisions "${CMAKE_CURRENT_LIST_DIR}"
    reader_selector_bytes_v1.h READER_REV_SELECTOR_BYTES_API_VERSION EXR_READER_PUBLIC_SELECTOR_BYTES_V1)
  if(EXISTS "${CMAKE_CURRENT_LIST_DIR}/../../../include/reader_selector_bytes_detail.h")
    message(FATAL_ERROR "Stale private selector header: install public-boundary packages into a fresh prefix")
  endif()
endif()
