@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
get_filename_component(_managed_session_dir "${CMAKE_CURRENT_LIST_DIR}/../EXReaderSession" REALPATH)
if(TARGET EXReaderSession::reader_session)
  get_filename_component(_managed_existing_dir "${EXReaderSession_DIR}" REALPATH)
  if(NOT _managed_existing_dir STREQUAL _managed_session_dir)
    message(FATAL_ERROR "Managed session and base package must share one installation")
  endif()
endif()
find_dependency(EXReaderSession 0.2.0 EXACT CONFIG PATHS "${_managed_session_dir}" NO_DEFAULT_PATH)
get_filename_component(_managed_loaded_dir "${EXReaderSession_DIR}" REALPATH)
if(NOT _managed_loaded_dir STREQUAL _managed_session_dir)
  message(FATAL_ERROR "Managed session and base package must share one installation")
endif()
find_dependency(EXReaderWebDAVManaged 0.1.0 EXACT CONFIG)
get_filename_component(_managed_session_prefix "${CMAKE_CURRENT_LIST_DIR}/../../.." REALPATH)
get_filename_component(_managed_dav_prefix "${EXReaderWebDAVManaged_DIR}/../../.." REALPATH)
get_target_property(_managed_session_defs EXReaderSession::reader_session INTERFACE_COMPILE_DEFINITIONS)
if(NOT _managed_session_prefix STREQUAL _managed_dav_prefix OR NOT "EXR_READER_SESSION_MANAGED=1" IN_LIST _managed_session_defs)
  message(FATAL_ERROR "Managed session requires the matching installed managed WebDAV family")
endif()
