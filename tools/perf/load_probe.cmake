# Instrument the already adapted R3 probe without changing product code or v1.
if(WIN32 AND CMAKE_SIZEOF_VOID_P EQUAL 8 AND CMAKE_C_COMPILER_ID STREQUAL "GNU")
  set(load "${ratio}")
  function(load_replace old new)
    string(FIND "${load}" "${old}" found)
    if(found LESS 0)
      message(FATAL_ERROR "Load probe adapter no longer matches: ${old}")
    endif()
    string(REPLACE "${old}" "${new}" load "${load}")
    set(load "${load}" PARENT_SCOPE)
  endfunction()
  load_replace("#include \"e1_platform.h\"" "#include \"e1_platform.h\"\n#include \"load_counters.h\"")
  load_replace("double layout_ms,render_ms,total_ms,reference_ms;" "double layout_ms,render_ms,total_ms,reference_ms;load_sample load;")
  load_replace("if(!e1_pin()) return 3;" "if(!e1_pin()) return 3;load_init();")
  load_replace("item->reference_ms=perf_reference_ms();" "item->reference_ms=load_begin(&item->load);")
  load_replace("item->layout_ms=now_ms()-at;" "item->load.layout_end=load_read();item->layout_ms=load_delta(item->load.start,item->load.layout_end).wall_ms;")
  load_replace("if(!layout) return 2;" "if(!layout) { item->load.transition=load_add(item->load.transition,load_delta(item->load.start,item->load.layout_end));return 2; }")
  load_replace("at=now_ms();if(!create_pager(publication,part,font,0,&pager,&error)) goto finish;"
    "load_stamp transition_start=load_read();at=now_ms();if(!create_pager(publication,part,font,0,&pager,&error)) goto finish;")
  load_replace("transition+=now_ms()-at;current_part=part;page=0;"
    "load_stamp transition_work=load_delta(transition_start,load_read());transition+=transition_work.wall_ms;samples[count].load.transition=load_add(samples[count].load.transition,transition_work);current_part=part;page=0;")
  load_replace("item->render_ms=item->total_ms=now_ms()-at;" "load_end(&item->load);item->render_ms=item->total_ms=load_delta(item->load.start,item->load.end).wall_ms;")
  load_replace("item->render_ms=now_ms()-at;item->total_ms=item->layout_ms+item->render_ms;" "load_end(&item->load);item->render_ms=load_delta(item->load.layout_end,item->load.end).wall_ms;item->total_ms=item->layout_ms+item->render_ms;")
  load_replace("\\\"explicit_snapshot_bytes\\\":%zu}" "\\\"explicit_snapshot_bytes\\\":%zu")
  load_replace("m->page_cache_bytes,m->checkpoint_bytes,m->explicit_snapshot_bytes);" "m->page_cache_bytes,m->checkpoint_bytes,m->explicit_snapshot_bytes);load_print_sample(&s->load);")
  file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/load_probe.c" "${load}")
  add_executable(load-probe "${CMAKE_CURRENT_BINARY_DIR}/load_probe.c" reference.c)
  target_include_directories(load-probe PRIVATE "${CMAKE_CURRENT_LIST_DIR}")
  target_link_libraries(load-probe PRIVATE exreader psapi)
  add_executable(load-reference load_reference.c reference.c)
  set(EXR_PERF_REFERENCE_STEPS 12000000 CACHE STRING "Fixed v2 reference iterations (freeze in policy)")
  target_compile_definitions(load-probe PRIVATE PERF_REFERENCE_STEPS=${EXR_PERF_REFERENCE_STEPS})
  target_compile_definitions(load-reference PRIVATE PERF_REFERENCE_STEPS=${EXR_PERF_REFERENCE_STEPS})
  target_link_libraries(load-reference PRIVATE psapi)
  target_link_options(load-probe PRIVATE "-Wl,--no-insert-timestamp")
  target_link_options(load-reference PRIVATE "-Wl,--no-insert-timestamp")
  if(EXR_BUILD_SHARED_COMPAT)
    add_custom_command(TARGET load-probe POST_BUILD COMMAND ${CMAKE_COMMAND} -E copy_if_different
      "$<TARGET_FILE:exreader>" "$<TARGET_FILE_DIR:load-probe>")
  endif()
endif()
