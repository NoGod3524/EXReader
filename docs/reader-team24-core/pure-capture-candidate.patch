diff --git a/apps/reader/reading-state/include/reader_reading_state_capture_raw_candidate.h b/apps/reader/reading-state/include/reader_reading_state_capture_raw_candidate.h
new file mode 100644
--- /dev/null
+++ b/apps/reader/reading-state/include/reader_reading_state_capture_raw_candidate.h
@@ -0,0 +1,26 @@
+/* SPDX-License-Identifier: MIT */
+#ifndef READER_READING_STATE_CAPTURE_RAW_CANDIDATE_H
+#define READER_READING_STATE_CAPTURE_RAW_CANDIDATE_H
+#include <reader_reading_state.h>
+#if !defined(EXR_READER_SELECTOR_BYTES_CANDIDATE) || !defined(EXR_READER_PURE_CAPTURE_CANDIDATE)
+#error "Use the explicitly installed pure raw capture candidate target"
+#endif
+#define READER_RS_PURE_CAPTURE_CANDIDATE_VERSION "0.1.0"
+#ifdef __cplusplus
+extern "C" {
+#endif
+/* Pure encode/validate, no revision/history/outbox insertion. Preserve the
+   supplied actual anchor version 1/2; version 3 is fixed_page only. All
+   existing representability and byte limits apply. Raw stores only.
+   On failure wire/count are cleared; release successful output with
+   reader_rs_free. part is the actual EPUB spine index, ignored otherwise. */
+reader_rs_status reader_rs_encode_capture_raw_candidate(
+  reader_revisions *store, const reader_rs_envelope *envelope,
+  const reader_rs_capture *capture, unsigned anchor_version, size_t part,
+  char **wire, size_t *bytes, reader_rs_error *error);
+#ifdef __cplusplus
+}
+#endif
+#endif
+
+
diff --git a/apps/reader/reading-state/src/reading_state.cpp b/apps/reader/reading-state/src/reading_state.cpp
--- a/apps/reader/reading-state/src/reading_state.cpp
+++ b/apps/reader/reading-state/src/reading_state.cpp
@@ -249,3 +249,19 @@
   return encode(s,e,c,version,part,w,n,error,true);
 }
 #endif
+
+#ifdef EXR_READER_PURE_CAPTURE_CANDIDATE
+#include "reader_reading_state_capture_raw_candidate.h"
+extern "C" reader_rs_status reader_rs_encode_capture_raw_candidate(
+    reader_revisions *s,const reader_rs_envelope *e,const reader_rs_capture *c,
+    unsigned version,size_t part,char **w,size_t *n,reader_rs_error *error) {
+  if(w)*w=nullptr;
+  if(n)*n=0;
+  if(version<1 || version>3 || (version==3 && (!c || c->mode!=READER_RS_FIXED_PAGE))) {
+    return call(error,[&]{
+      reject(READER_RS_ARGUMENT,"Pure raw capture requires anchor 1/2, or fixed_page anchor3");
+    });
+  }
+  return encode(s,e,c,version,part,w,n,error,true);
+}
+#endif
