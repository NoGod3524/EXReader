  "gaps": [
    {
      "id": "hint-absent",
      "criterion": "控件提示（accessibilityHint）",
      "actual": "HostViews.swift 全文没有任何 accessibilityHint",
      "expected": "会改变状态的控件应说明结果（例如翻页、导入、删除标注）",
      "fix": "为翻页/导入/删除标注补 .accessibilityHint；若判定不需要，在 README 中记录理由",
      "severity": "minor",
      "source_file": "examples/apple/HostViews.swift",
      "source_check": "source citation holds"
    },
    {
      "id": "header-traits-absent",
      "criterion": "标题语义（isHeader）",
      "actual": "无 .accessibilityAddTraits(.isHeader)",
      "expected": "书架/阅读/标注面板标题应带标题语义，便于按标题导航",
      "fix": "给 library.title、selection.title、notes.title、notes.edit.title 加 .isHeader",
      "severity": "minor",
      "source_file": "examples/apple/HostViews.swift",
      "source_check": "source citation holds"
    },
    {
      "id": "sort-priority-absent",
      "criterion": "阅读顺序优先级（accessibilitySortPriority）",
      "actual": "依赖默认容器顺序",
      "expected": "跨容器布局（阅读面与控制栏）应显式声明排序优先级",
      "fix": "为 reader.page 与底部控制栏加 accessibilitySortPriority",
      "severity": "minor",
      "source_file": "examples/apple/HostViews.swift",
      "source_check": "source citation holds"
    },
    {
      "id": "status-not-announced",
      "criterion": "状态变化播报",
      "actual": "状态只更新 Text，不触发播报；VoiceOver 用户需要手动逐项巡检",
      "expected": "导入完成/失败、页面更新、标注保存等状态变化应主动播报",
      "fix": "在 statusText 变化处 post .announcement，或给状态 Text 加 .accessibilityAddTraits(.updatesFrequently)",
      "severity": "major",
      "source_file": "examples/apple/HostViews.swift",
      "source_check": "source citation holds"
    },
    {
      "id": "reader-not-scrollable",
      "criterion": "大字体/小窗口下的滚动回退",
      "actual": "ReaderScreen 主体是固定 VStack（183-267），只有书架和标注面板用 ScrollView（91/420）",
      "expected": "固定高度的控制栈在大字体或最小窗口下应可滚动，避免控件被裁掉",
      "fix": "把阅读器控制区包进 ScrollView，或在大字体下折叠为单一工具行",
      "severity": "major",
      "source_file": "examples/apple/HostViews.swift",
      "source_check": "source citation holds"
    },
    {
      "id": "copy-annotate-enabled-without-selection",
      "criterion": "控件可用状态与实际动作一致",
      "actual": "只按 .disabled(!isCurrent) 控制；未选文时按钮可用，按下后仅在 selection.hint 提示“请先选择文字”",
      "expected": "未选文时“复制/标注所选”应不可用，或明确标注为会被拒绝",
      "fix": "把 .disabled 条件扩展为 !isCurrent || quote.isEmpty",
      "severity": "minor",
      "source_file": "examples/apple/HostViews.swift",
      "source_check": "source citation holds"
    },
    {
      "id": "named-icons-not-hidden",
      "criterion": "装饰性图像对辅助技术隐藏",
      "actual": "Image(systemName: \"chevron.right\") 没有 accessibilityHidden(true)，按钮内节点合并依赖默认行为",
      "expected": "chevron 等装饰图像应隐藏，避免多余节点",
      "fix": "给装饰图像加 .accessibilityHidden(true)",
      "severity": "minor",
      "source_file": "examples/apple/HostViews.swift",
      "source_check": "source citation holds"
    },
    {
      "id": "page-label-60-chars",
      "criterion": "阅读面文本替身完整性",
      "actual": "HostModel.swift:428-431 的 pageLabel 只取页文本前 60 字，其余内容对辅助技术不可见",
      "expected": "阅读面的可访问名称/值应覆盖整页文本，或提供逐段导航",
      "fix": "页文本放进 accessibilityValue（或自定义 rotor 逐段暴露），名称保留页号；不要用名称承载整页正文",
      "severity": "major",
      "source_file": "examples/apple/HostModel.swift",
      "source_check": "source citation holds"
    }
  ],
