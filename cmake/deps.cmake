include(FetchContent)
set(CMAKE_POLICY_DEFAULT_CMP0077 NEW)
set(SKIP_INSTALL_ALL ON CACHE BOOL "" FORCE)
set(BUILD_SHARED_LIBS OFF)
set(FT_DISABLE_ZLIB ON CACHE BOOL "" FORCE)
set(FT_DISABLE_BZIP2 ON CACHE BOOL "" FORCE)
set(FT_DISABLE_PNG ON CACHE BOOL "" FORCE)
set(FT_DISABLE_HARFBUZZ ON CACHE BOOL "" FORCE)
set(FT_DISABLE_BROTLI ON CACHE BOOL "" FORCE)
set(EXPAT_BUILD_TOOLS OFF CACHE BOOL "" FORCE)
set(EXPAT_BUILD_EXAMPLES OFF CACHE BOOL "" FORCE)
set(EXPAT_BUILD_TESTS OFF CACHE BOOL "" FORCE)
set(EXPAT_SHARED_LIBS OFF CACHE BOOL "" FORCE)
set(EXPAT_MSVC_STATIC_CRT ON CACHE BOOL "" FORCE)
set(EXPAT_ENABLE_INSTALL OFF CACHE BOOL "" FORCE)
set(BUILD_EXAMPLES OFF)
set(BUILD_TESTS OFF)
set(INSTALL_PROJECT OFF)
FetchContent_Declare(freetype URL "https://codeload.github.com/freetype/freetype/tar.gz/refs/tags/VER-2-14-1" URL_HASH SHA256=44bd69d1f0750603410cfd4f26f1c5523c5a3a087a2dfa8639b757dc7c6677be)
FetchContent_Declare(expat URL "https://codeload.github.com/libexpat/libexpat/tar.gz/refs/tags/R_2_9_0" URL_HASH SHA256=6e8ce7b52ebbaa423c59becc7cf1e6875c42e49228c062ac8123c10e700cec27 SOURCE_SUBDIR expat)
FetchContent_Declare(miniz URL "https://codeload.github.com/richgel999/miniz/tar.gz/refs/tags/3.1.2" URL_HASH SHA256=98468f8924934b723276680f85238b6c78bf1f8b49b4459cc9b7214a20e2e9fb)
FetchContent_Declare(sqlite URL "https://www.sqlite.org/2026/sqlite-amalgamation-3540000.zip" URL_HASH SHA256=68e913b0fe8ec6b4e5f391c594a28872884e80d6cd042a1e50c957be46b5aa4d)
FetchContent_MakeAvailable(freetype expat miniz sqlite)
FetchContent_Declare(stb URL "https://codeload.github.com/nothings/stb/tar.gz/2c980bb59875b0d32144a71867fbdebb2f77cd20" URL_HASH SHA256=9a955b1b49a4410088a2e0ee2a9c057c3c907d0c1d75454144cb980aca0ba515)
FetchContent_MakeAvailable(stb)
if(EXR_ENABLE_MP3)
  FetchContent_Declare(minimp3 URL "https://codeload.github.com/lieff/minimp3/tar.gz/ea99364f61c14656440e8d77e9c233ccf3124633" URL_HASH SHA256=5628166eb82a9bb581317918a334c317a2c0a30278bb14a20381307976768f34 SOURCE_SUBDIR exreader-header-only)
  FetchContent_MakeAvailable(minimp3)
endif()
if(EXR_ENABLE_AAC)
  set(FAAD_BUNDLED_MODE ON)
  set(FAAD_BUILD_CLI OFF CACHE BOOL "" FORCE)
  FetchContent_Declare(faad2 URL "https://codeload.github.com/knik0/faad2/tar.gz/521d105979795b887ea11e1f36565e97a8fbfc53" URL_HASH SHA256=9284bd9c5ef998f636b233055f4d988aadf0d5a97acdb3109bcb9d4e3c7cfdd8)
  FetchContent_MakeAvailable(faad2)
  set_target_properties(faad_drm faad_fixed faad_drm_fixed PROPERTIES EXCLUDE_FROM_ALL TRUE)
endif()
add_library(exr_sqlite STATIC ${sqlite_SOURCE_DIR}/sqlite3.c)
target_include_directories(exr_sqlite PUBLIC ${sqlite_SOURCE_DIR})
target_compile_definitions(exr_sqlite PRIVATE SQLITE_THREADSAFE=1 SQLITE_DQS=0 SQLITE_DEFAULT_FOREIGN_KEYS=1 SQLITE_OMIT_LOAD_EXTENSION)
if(EXR_ENABLE_TEXT_INDEX)
  target_compile_definitions(exr_sqlite PRIVATE SQLITE_ENABLE_FTS5)
endif()
if(UNIX)
  target_link_libraries(exr_sqlite PUBLIC m ${CMAKE_DL_LIBS})
endif()

if(NOT WIN32)
  find_package(Threads REQUIRED)
  target_link_libraries(exr_sqlite PUBLIC Threads::Threads)
endif()
