# Record the active object targets so dependency checks ignore stale objects
# from disabled modules or an earlier aggregate build.
string(JOIN "\",\"" exr_active ${exr_layers})
string(JSON exr_build_files GET "${exr_manifest}" files)
file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/exr-modules.json" "{\"layers\":[\"${exr_active}\"],\"files\":${exr_build_files}}\n")

if(EXR_BUILD_SHARED_COMPAT)
  add_library(exreader SHARED ${exr_objects})
  target_include_directories(exreader PUBLIC $<BUILD_INTERFACE:${CMAKE_CURRENT_BINARY_DIR}/generated/include> $<BUILD_INTERFACE:${CMAKE_CURRENT_SOURCE_DIR}/include> $<INSTALL_INTERFACE:include>)
  target_link_libraries(exreader PRIVATE ${EXR_COMPONENT_TARGETS})
  set_target_properties(exreader PROPERTIES LINKER_LANGUAGE C VERSION ${PROJECT_VERSION} SOVERSION ${EXR_ABI_VERSION})
  # One public ABI for every shared-library format. Static component archives
  # retain their internal definitions for static linking.
  set(exr_public_symbols)
  foreach(layer IN LISTS exr_layers)
    if(layer STREQUAL "doc")
      set(public_header document)
    else()
      set(public_header ${layer})
    endif()
    file(READ "${CMAKE_CURRENT_SOURCE_DIR}/include/exr/${public_header}.h" declarations)
    if(EXR_HAS_EDIT_REFLOW AND layer STREQUAL "doc")
      file(READ "${CMAKE_CURRENT_SOURCE_DIR}/include/exr/edit.h" edit_declarations)
      string(APPEND declarations "\n${edit_declarations}")
    endif()
    if(layer STREQUAL "layout")
      file(READ "${CMAKE_CURRENT_SOURCE_DIR}/include/exr/reflow.h" reflow_declarations)
      string(APPEND declarations "\n${reflow_declarations}")
    endif()
    if(layer STREQUAL "text")
      file(READ "${CMAKE_CURRENT_SOURCE_DIR}/include/exr/font_manager.h" manager_declarations)
      string(APPEND declarations "\n${manager_declarations}")
      file(READ "${CMAKE_CURRENT_SOURCE_DIR}/include/exr/dictionary.h" dictionary_declarations)
      string(APPEND declarations "\n${dictionary_declarations}")
    endif()
    string(REGEX MATCHALL "EXR_API[^;]+;" declarations "${declarations}")
    foreach(declaration IN LISTS declarations)
      string(REGEX MATCH "exr_[a-zA-Z0-9_]+[(]" symbol "${declaration}")
      string(REGEX REPLACE "[(]$" "" symbol "${symbol}")
      if(symbol)
        list(APPEND exr_public_symbols "${symbol}")
      endif()
    endforeach()
  endforeach()
  list(REMOVE_DUPLICATES exr_public_symbols)
  list(SORT exr_public_symbols)
  string(JOIN "\n" exr_public_symbol_lines ${exr_public_symbols})
  file(CONFIGURE OUTPUT "${CMAKE_CURRENT_BINARY_DIR}/public-symbols.txt"
    CONTENT "${exr_public_symbol_lines}\n" @ONLY)
  if(WIN32)
    set(exr_export_file "${CMAKE_CURRENT_BINARY_DIR}/exreader.def")
    string(JOIN "\n  " exports ${exr_public_symbols})
    file(CONFIGURE OUTPUT "${exr_export_file}" CONTENT "EXPORTS\n  ${exports}\n" @ONLY)
    target_sources(exreader PRIVATE "${exr_export_file}")
  elseif(APPLE)
    set(exr_export_file "${CMAKE_CURRENT_BINARY_DIR}/exreader.exports")
    string(JOIN "\n_" exports ${exr_public_symbols})
    file(CONFIGURE OUTPUT "${exr_export_file}" CONTENT "_${exports}\n" @ONLY)
    target_link_options(exreader PRIVATE "LINKER:-exported_symbols_list,${exr_export_file}")
  elseif(UNIX)
    set(exr_export_file "${CMAKE_CURRENT_BINARY_DIR}/exreader.map")
    string(JOIN ";\n    " exports ${exr_public_symbols})
    file(CONFIGURE OUTPUT "${exr_export_file}" CONTENT "{\n  global:\n    ${exports};\n  local: *;\n};\n" @ONLY)
    target_link_options(exreader PRIVATE "LINKER:--version-script=${exr_export_file}")
  endif()
  if(exr_export_file)
    set_property(TARGET exreader APPEND PROPERTY LINK_DEPENDS "${exr_export_file}")
  endif()
  if(ANDROID)
    target_link_options(exreader PRIVATE -Wl,-z,max-page-size=16384)
  endif()
  if(MINGW)
    target_link_options(exreader PRIVATE -static-libgcc -static)
  endif()
else()
  add_library(exreader INTERFACE)
  target_link_libraries(exreader INTERFACE ${EXR_COMPONENT_TARGETS})
endif()
