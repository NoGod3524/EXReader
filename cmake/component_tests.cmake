if(EXR_BUILD_TESTS)
  enable_testing()
  add_executable(exreader-core-component-test tests/test_core_component.c)
  target_link_libraries(exreader-core-component-test PRIVATE exr_core)
  add_test(NAME native-core-component COMMAND exreader-core-component-test ${CMAKE_CURRENT_SOURCE_DIR}/tests/fixtures/fonts/primary.ttf)
endif()

# Direct-source regression executables define a few public helpers themselves.
# They must not import those same declarations from the aggregate DLL.
if(EXR_FULL_TESTS)
  get_property(test_targets DIRECTORY PROPERTY BUILDSYSTEM_TARGETS)
  foreach(target IN LISTS test_targets)
    get_target_property(kind ${target} TYPE)
    if(kind STREQUAL "EXECUTABLE")
      get_target_property(sources ${target} SOURCES)
      foreach(source IN LISTS sources)
        if(source MATCHES "^src/")
          target_compile_definitions(${target} PRIVATE EXR_STATIC)
          break()
        endif()
      endforeach()
    endif()
  endforeach()
endif()

if(EXR_BUILD_TESTS)
  foreach(header IN LISTS exr_public_headers)
    get_filename_component(name "${header}" NAME_WE)
    file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/generated/header_${name}.c" "#include \"exr/${name}.h\"\n")
    add_library(exr_header_${name} OBJECT "${CMAKE_CURRENT_BINARY_DIR}/generated/header_${name}.c")
    target_include_directories(exr_header_${name} PRIVATE include)
    target_compile_definitions(exr_header_${name} PRIVATE EXR_STATIC)
  endforeach()
  foreach(component audio library pdf_edit textindex)
    if(TARGET exr_${component})
      if(component STREQUAL "audio")
        set(test_source tests/test_audio.c)
      elseif(component STREQUAL "library")
        set(test_source tests/test_library_component.c)
      elseif(component STREQUAL "pdf_edit")
        set(test_source tests/test_pdf_write.c)
      else()
        set(test_source tests/test_textindex_component.c)
      endif()
      file(MAKE_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}/components/${component}")
      add_executable(exreader-${component}-component-test ${test_source})
      target_link_libraries(exreader-${component}-component-test PRIVATE exr_${component})
      if(component STREQUAL "library" AND EXR_ENABLE_PDF)
        target_compile_definitions(exreader-${component}-component-test PRIVATE EXR_TEST_PDF=1)
      endif()
      add_test(NAME native-${component}-component COMMAND exreader-${component}-component-test "${CMAKE_CURRENT_BINARY_DIR}/components/${component}")
    endif()
  endforeach()
endif()
