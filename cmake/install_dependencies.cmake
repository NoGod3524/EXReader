# SPDX-License-Identifier: MIT
get_property(vendors GLOBAL PROPERTY EXR_VENDOR_TARGETS)
list(REMOVE_DUPLICATES vendors)
set(exr_dependency_config "# Private static dependencies; no public headers required.\n")
if(UNIX)
  string(APPEND exr_dependency_config "include(CMakeFindDependencyMacro)\nfind_dependency(Threads)\n")
endif()
foreach(vendor IN LISTS vendors)
  set(filename "${CMAKE_STATIC_LIBRARY_PREFIX}exr_vendor_${vendor}${CMAKE_STATIC_LIBRARY_SUFFIX}")
  install(FILES $<TARGET_FILE:${vendor}> DESTINATION lib/exreader RENAME "${filename}")
  string(APPEND exr_dependency_config "if(NOT TARGET EXReader::vendor_${vendor})\n  add_library(EXReader::vendor_${vendor} STATIC IMPORTED)\n  set_target_properties(EXReader::vendor_${vendor} PROPERTIES IMPORTED_LOCATION \"\${PACKAGE_PREFIX_DIR}/lib/exreader/${filename}\")\n")
  if(UNIX AND (vendor STREQUAL "exr_sqlite" OR vendor STREQUAL "exr_lcms"))
    string(APPEND exr_dependency_config "  set_property(TARGET EXReader::vendor_${vendor} PROPERTY INTERFACE_LINK_LIBRARIES \"Threads::Threads;m;${CMAKE_DL_LIBS}\")\n")
  endif()
  string(APPEND exr_dependency_config "endif()\n")
endforeach()
file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/EXReaderDependencies.cmake" "${exr_dependency_config}")
install(FILES "${CMAKE_CURRENT_BINARY_DIR}/EXReaderDependencies.cmake" DESTINATION lib/cmake/EXReader)
