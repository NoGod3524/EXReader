# Resolve an exact installed SDK identity, including explicitly selected old SDKs.
if(NOT EXR_SDK)
  message(FATAL_ERROR "Unsupported exact reader SDK version: provide EXR_SDK with an installed version header")
endif()
include("${EXR_SDK}/lib/cmake/EXReader/EXReaderConfigVersion.cmake")
if(EXISTS "${EXR_SDK}/include/exr/version.h")
  file(STRINGS "${EXR_SDK}/include/exr/version.h" _sdk_line REGEX "^#define EXR_SDK_VERSION ")
else()
  file(STRINGS "${EXR_SDK}/include/exr/base.h" _sdk_line REGEX "^#define EXR_VERSION ")
endif()
string(REGEX MATCH "[0-9]+\\.[0-9]+\\.[0-9]+" _sdk_header_version "${_sdk_line}")
if(NOT _sdk_header_version OR NOT _sdk_header_version VERSION_EQUAL PACKAGE_VERSION)
  message(FATAL_ERROR "Installed SDK header and package versions differ")
endif()
if(DEFINED EXR_SDK_VERSION AND NOT EXR_SDK_VERSION VERSION_EQUAL _sdk_header_version)
  message(FATAL_ERROR "Unsupported exact reader SDK version: ${EXR_SDK_VERSION}; installed ${_sdk_header_version}")
endif()
set(EXR_SDK_VERSION "${_sdk_header_version}" CACHE STRING "Exact installed SDK identity")
