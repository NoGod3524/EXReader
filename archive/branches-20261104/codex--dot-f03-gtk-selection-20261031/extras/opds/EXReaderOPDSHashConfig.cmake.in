@PACKAGE_INIT@
# Repeated find_dependency may skip discovery: callers invoke this guard again.
function(exreader_opds_hash_validate prefix)
  file(REAL_PATH "${prefix}" _root)
  if(NOT IS_ABSOLUTE "${prefix}" OR NOT "${prefix}" STREQUAL "${_root}")
    message(FATAL_ERROR "OPDSHash requires an explicit canonical absolute prefix")
  endif()
  set(_target EXReaderOPDSHash::opds_sha256_stream)
  if(NOT TARGET ${_target})
    message(FATAL_ERROR "OPDSHash imported target missing")
  endif()
  get_target_property(_imported ${_target} IMPORTED)
  get_target_property(_type ${_target} TYPE)
  get_target_property(_origin ${_target} _EXREADER_OPDS_HASH_ORIGIN)
  if(NOT "${_origin}" STREQUAL "${_root}/lib/cmake/EXReaderOPDSHash/EXReaderOPDSHashConfig.cmake")
    message(FATAL_ERROR "OPDSHash target was not initialized by its canonical package")
  endif()
  get_target_property(_includes ${_target} INTERFACE_INCLUDE_DIRECTORIES)
  set(_header "${_root}/include/exreader-opds-hash/opds_sha256_stream.h")
  if(NOT _imported OR NOT _type STREQUAL "STATIC_LIBRARY" OR
      NOT "${_includes}" STREQUAL "${_root}/include/exreader-opds-hash" OR NOT EXISTS "${_header}")
    message(FATAL_ERROR "OPDSHash target/include ownership mismatch")
  endif()
  file(REAL_PATH "${_header}" _real_header)
  if(NOT "${_real_header}" STREQUAL "${_header}")
    message(FATAL_ERROR "OPDSHash header alias is not allowed")
  endif()
  set(_archive "${_root}/lib/${CMAKE_STATIC_LIBRARY_PREFIX}opds_sha256_stream${CMAKE_STATIC_LIBRARY_SUFFIX}")
  if(NOT EXISTS "${_archive}")
    message(FATAL_ERROR "OPDSHash canonical archive missing")
  endif()
  file(REAL_PATH "${_archive}" _real_archive)
  if(NOT "${_real_archive}" STREQUAL "${_archive}")
    message(FATAL_ERROR "OPDSHash archive alias is not allowed")
  endif()
  get_target_property(_configs ${_target} IMPORTED_CONFIGURATIONS)
  if(NOT _configs)
    message(FATAL_ERROR "OPDSHash lacks imported configuration ownership")
  endif()
  foreach(_config IN LISTS _configs)
    string(TOUPPER "${_config}" _config)
    get_target_property(_location ${_target} IMPORTED_LOCATION_${_config})
    if(NOT "${_location}" STREQUAL "${_archive}")
      message(FATAL_ERROR "OPDSHash imported archive escapes its exact owner")
    endif()
    foreach(_property IMPORTED_LINK_INTERFACE_LIBRARIES IMPORTED_LINK_DEPENDENT_LIBRARIES IMPORTED_IMPLIB)
      get_target_property(_extra ${_target} ${_property}_${_config})
      if(_extra)
        message(FATAL_ERROR "OPDSHash unexpected configured requirement: ${_property}_${_config}")
      endif()
    endforeach()
  endforeach()
  get_target_property(_plain ${_target} IMPORTED_LOCATION)
  if(_plain AND NOT "${_plain}" STREQUAL "${_archive}")
    message(FATAL_ERROR "OPDSHash unconfigured location mismatch")
  endif()
  get_target_property(_links ${_target} INTERFACE_LINK_LIBRARIES)
  if(_links)
    message(FATAL_ERROR "OPDSHash must have no transitive package dependencies")
  endif()
  foreach(_property INTERFACE_LINK_OPTIONS INTERFACE_COMPILE_OPTIONS INTERFACE_COMPILE_DEFINITIONS
      INTERFACE_SOURCES INTERFACE_LINK_DIRECTORIES INTERFACE_SYSTEM_INCLUDE_DIRECTORIES
      IMPORTED_LINK_INTERFACE_LIBRARIES IMPORTED_LINK_DEPENDENT_LIBRARIES)
    get_target_property(_extra ${_target} ${_property})
    if(_extra)
      message(FATAL_ERROR "OPDSHash unexpected usage requirement: ${_property}")
    endif()
  endforeach()
endfunction()
file(REAL_PATH "${CMAKE_CURRENT_LIST_FILE}" _hash_origin)
if(TARGET EXReaderOPDSHash::opds_sha256_stream)
  get_target_property(_prior_origin EXReaderOPDSHash::opds_sha256_stream _EXREADER_OPDS_HASH_ORIGIN)
  if(NOT "${_prior_origin}" STREQUAL "${_hash_origin}")
    message(FATAL_ERROR "Pre-created or foreign OPDSHash target is forbidden")
  endif()
else()
  include("${CMAKE_CURRENT_LIST_DIR}/EXReaderOPDSHashTargets.cmake")
  set_property(TARGET EXReaderOPDSHash::opds_sha256_stream PROPERTY _EXREADER_OPDS_HASH_ORIGIN "${_hash_origin}")
endif()
get_filename_component(_hash_prefix "${CMAKE_CURRENT_LIST_DIR}/../../.." ABSOLUTE)
exreader_opds_hash_validate("${_hash_prefix}")
check_required_components(EXReaderOPDSHash)
