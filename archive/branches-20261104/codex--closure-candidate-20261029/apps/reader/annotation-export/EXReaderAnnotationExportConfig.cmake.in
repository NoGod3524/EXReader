@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
find_dependency(EXReaderRevisions @EXR_REVISIONS_VERSION@ EXACT CONFIG)
find_dependency(EXReaderReadingState @EXR_READING_STATE_VERSION@ EXACT CONFIG)
include("${CMAKE_CURRENT_LIST_DIR}/EXReaderAnnotationExportTargets.cmake")

# RAW-CANDIDATE ORIGIN GUARD: append-only; never changes imported targets.
if(@EXR_READER_SELECTOR_BYTES_CANDIDATE@)
  _exr_raw_guard_target(EXReaderAnnotationExport::reader_annotation_export "${CMAKE_CURRENT_LIST_DIR}"
    reader_annotation_export_raw3.h READER_ANNOTATION_EXPORT_RAW3_VERSION 0.2.0 TRUE)
endif()

if(@EXR_READER_SELECTOR_BYTES_CANDIDATE@)
  _exr_public_boundary_guard(EXReaderRevisions::reader_revisions "${EXReaderRevisions_DIR}"
    reader_selector_bytes_v1.h READER_REV_SELECTOR_BYTES_API_VERSION EXR_READER_PUBLIC_SELECTOR_BYTES_V1)
  _exr_public_boundary_guard(EXReaderReadingState::reader_reading_state_codec "${EXReaderReadingState_DIR}"
    reader_reading_state_retained_raw_v1.h READER_RS_RETAINED_RAW_API_VERSION EXR_READER_PUBLIC_RETAINED_RAW_V1)
endif()
