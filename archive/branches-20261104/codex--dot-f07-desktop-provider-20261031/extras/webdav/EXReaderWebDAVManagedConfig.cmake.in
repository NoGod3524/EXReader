@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
get_filename_component(_managed_webdav_dir "${CMAKE_CURRENT_LIST_DIR}/../EXReaderWebDAV" REALPATH)
if(TARGET EXReaderWebDAV::exr_webdav)
  get_filename_component(_managed_existing_dir "${EXReaderWebDAV_DIR}" REALPATH)
  if(NOT _managed_existing_dir STREQUAL _managed_webdav_dir)
    message(FATAL_ERROR "Managed capability and loaded WebDAV package must come from the same installation")
  endif()
endif()
find_dependency(EXReaderWebDAV 0.2.0 EXACT CONFIG PATHS "${_managed_webdav_dir}" NO_DEFAULT_PATH)
get_filename_component(_managed_loaded_dir "${EXReaderWebDAV_DIR}" REALPATH)
if(NOT _managed_loaded_dir STREQUAL _managed_webdav_dir)
  message(FATAL_ERROR "Managed capability and WebDAV package must come from the same installation")
endif()

get_target_property(_managed_defs EXReaderWebDAV::exr_webdav INTERFACE_COMPILE_DEFINITIONS)
if(NOT "EXR_WEBDAV_MANAGED=1" IN_LIST _managed_defs)
  message(FATAL_ERROR "WebDAV installation lacks managed cleanup capability")
endif()
get_filename_component(_managed_prefix "${CMAKE_CURRENT_LIST_DIR}/../../.." REALPATH)
get_filename_component(_managed_cleanup_prefix "${EXReaderWebDAVCleanup_DIR}/../../.." REALPATH)
if(NOT _managed_prefix STREQUAL _managed_cleanup_prefix)
  message(FATAL_ERROR "Managed WebDAV and cleanup must come from the same installation")
endif()
