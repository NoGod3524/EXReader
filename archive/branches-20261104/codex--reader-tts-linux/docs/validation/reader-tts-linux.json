  "rework": {
    "review": "docs/handoffs/reader-next-wave/J19-ROOT-REVIEW.md at 4adac9c4",
    "gaps": [
      {
        "id": "close-thread-failure",
        "previous_behaviour": "reader_tts_request_close() called closer_main() on the calling thread when pthread_create() failed, closing the socket and joining the event thread on the owner's thread and leaving no way back",
        "now": "the call changes nothing and fails with MEMORY (native_code = the pthread_create error); the request, its queued events and the connection stay, the state is restored under the callback mutex without reviving a finished request, and the owner may retry",
        "evidence": [
          "hook_close_thread_failure_status (real EAGAIN from pthread_create via RLIMIT_NPROC)",
          "hook_close_thread_failure_keeps_request (state, request id, connection, slot and queue depth unchanged)",
          "hook_close_thread_failure_destroy_busy (destroy still refuses)",
          "hook_close_gate_reached + hook_close_handover_after_join (the retry closes normally)"
        ]
      },
      {
        "id": "slot-handover",
        "previous_behaviour": "drop_conn() released the process-wide callback slot before spd_close(), so another handle could take the slot and open a second connection while the old libspeechd event thread was still alive",
        "now": "the slot is kept until spd_close() has joined the old event thread; no lock the callbacks need is held across the close",
        "evidence": [
          "hook_close_gate_slot_still_owned (slot still held inside the real close)",
          "hook_close_gate_blocks_other_owner (a second owner cannot connect or speak)",
          "hook_close_gate_destroy_busy (the closing handle is not destroyable)",
          "hook_close_handover_after_join + hook_close_new_owner_connects (the new owner connects only after the join)",
          "hook_close_stale_callback_ignored (a stale callback does not touch the new request)"
        ]
      }
    ],
    "new_named_cases": 17,
    "cases_expected": 155
  },
  "close_boundary_evidence": {
    "release thread creation failure": {
      "injection": "RLIMIT_NPROC lowered to 1 for the duration of the call (a real EAGAIN from pthread_create), restored immediately",
      "observed": {
        "hook_close_thread_failure_status": "squeezed=1 status=7 native=11",
        "hook_close_thread_failure_keeps_request": "state=2 id=501 conn=1 slot=1 depth=0/0",
        "hook_close_thread_failure_destroy_busy": "status=3",
        "hook_close_handover_after_join": "closed=1 old_owner_slot=0 (the retry closes normally)"
      }
    },
    "connection handover": {
      "mechanism": "test gate inside the real release: slot still held, old event thread still alive, no lock held",
      "observed": {
        "hook_close_gate_slot_still_owned": "slot_owner_is_old=1",
