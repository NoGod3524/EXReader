# LeakSanitizer suppressions for the J19 runner.
# The library owns and frees everything it allocates; these entries cover the
# system libspeechd/libglib allocations that outlive the test process.
# __getdelim: libspeechd 0.11.1 keeps the last three reply lines (3 x 120 bytes)
# in a libc getline buffer that it never frees; the stack frame it appears with is
# unresolved ("<unknown module>") on ubuntu-22.04, so the frame is named here.
leak:__getdelim
leak:libspeechd.so
leak:libglib-2.0.so
leak:libgobject-2.0.so
leak:libpulse.so
leak:libpulsecommon
leak:libdbus-1.so
leak:libespeak-ng.so
