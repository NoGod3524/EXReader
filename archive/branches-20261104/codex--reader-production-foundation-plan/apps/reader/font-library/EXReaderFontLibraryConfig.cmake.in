@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
# Exactly the SDK this package was built against; no second version/provider.
find_dependency(EXReader @EXR_SDK_VERSION@ EXACT CONFIG COMPONENTS core)
include("${CMAKE_CURRENT_LIST_DIR}/EXReaderSdkTargetGuard.cmake")
_exr_sdk_target_provenance(EXReader::exr_core "${EXReader_DIR}" "@EXR_SDK_VERSION@")
find_dependency(Threads)
include("${CMAKE_CURRENT_LIST_DIR}/EXReaderFontLibraryTargets.cmake")
