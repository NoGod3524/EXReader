# Narrow installed-SDK provenance check. Reuses the REAL_PATH/header/archive
# checks in revisions/EXReaderRevisionsConfig.cmake.in; never rewrites targets.
# This file can be installed unchanged beside another optional package Config.
function(_exr_sdk_target_provenance target config_dir version)
  if(NOT TARGET "${target}")
    message(FATAL_ERROR "SDK imported target missing: ${target}")
  endif()
  set(_visited ${ARGN})
  if("${target}" IN_LIST _visited)
    return()
  endif()
  list(APPEND _visited "${target}")
  get_target_property(_imported "${target}" IMPORTED)
  if(NOT _imported)
    message(FATAL_ERROR "SDK target is not imported from an installation: ${target}")
  endif()
  file(REAL_PATH "${config_dir}/../../.." _prefix)
  get_target_property(_type "${target}" TYPE)
  if(NOT _type STREQUAL "INTERFACE_LIBRARY")
    if(NOT "${target}" MATCHES "^EXReader::vendor_")
    get_target_property(_includes "${target}" INTERFACE_INCLUDE_DIRECTORIES)
    set(_header_found FALSE)
    foreach(_include IN LISTS _includes)
      file(REAL_PATH "${_include}" _directory)
      cmake_path(IS_PREFIX _prefix "${_directory}" NORMALIZE _inside)
      if(NOT _inside OR NOT IS_DIRECTORY "${_directory}")
        message(FATAL_ERROR "SDK imported target header origin mismatch: ${target}")
      endif()
      if(EXISTS "${_directory}/exr/base.h")
        file(REAL_PATH "${_directory}/exr/base.h" _header)
        cmake_path(IS_PREFIX _prefix "${_header}" NORMALIZE _inside)
        if(NOT _inside)
          message(FATAL_ERROR "SDK imported target header origin mismatch: ${target}")
        endif()
        file(READ "${_header}" _text)
        string(FIND "${_text}" "#define EXR_VERSION \"${version}\"" _version)
        if(_version EQUAL -1)
          message(FATAL_ERROR "SDK imported target header version mismatch: ${target}")
        endif()
        set(_header_found TRUE)
      endif()
    endforeach()
    if(NOT _header_found)
      message(FATAL_ERROR "SDK imported target public header missing: ${target}")
    endif()
    endif()
    get_target_property(_configs "${target}" IMPORTED_CONFIGURATIONS)
    set(_properties IMPORTED_LOCATION IMPORTED_IMPLIB)
    foreach(_config IN LISTS _configs)
      string(TOUPPER "${_config}" _config)
      list(APPEND _properties "IMPORTED_LOCATION_${_config}" "IMPORTED_IMPLIB_${_config}")
    endforeach()
    set(_archive_found FALSE)
    foreach(_property IN LISTS _properties)
      get_target_property(_location "${target}" "${_property}")
      if(_location)
        file(REAL_PATH "${_location}" _archive)
        cmake_path(IS_PREFIX _prefix "${_archive}" NORMALIZE _inside)
        if(NOT _inside OR NOT EXISTS "${_archive}")
          message(FATAL_ERROR "SDK imported target archive origin mismatch: ${target}")
        endif()
        set(_archive_found TRUE)
      endif()
    endforeach()
    if(NOT _archive_found)
      message(FATAL_ERROR "SDK imported target archive missing: ${target}")
    endif()
  endif()
  get_target_property(_links "${target}" INTERFACE_LINK_LIBRARIES)
  set(_sdk_children)
  foreach(_link IN LISTS _links)
    if(_link MATCHES "^\\$<LINK_ONLY:([^<>]+)>$")
      set(_link "${CMAKE_MATCH_1}")
    endif()
    if(_link MATCHES "^EXReader::(exr_[A-Za-z0-9_]+|exreader|vendor_[A-Za-z0-9_]+)$")
      list(APPEND _sdk_children "${_link}")
    elseif(_link MATCHES "EXReader::")
      message(FATAL_ERROR "SDK imported target dependency cannot be authenticated: ${_link}")
    endif()
  endforeach()
  if(_type STREQUAL "INTERFACE_LIBRARY" AND NOT _sdk_children)
    message(FATAL_ERROR "SDK imported interface target has no SDK closure: ${target}")
  endif()
  foreach(_child IN LISTS _sdk_children)
    _exr_sdk_target_provenance("${_child}" "${config_dir}" "${version}" ${_visited})
  endforeach()
endfunction()
