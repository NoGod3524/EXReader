# Same R3/19-book adapter as #97; direct per-book cycles with no ratio of p95s.
if(WIN32 OR CMAKE_SYSTEM_NAME STREQUAL "Linux")
  set(gate "${ratio}")
  function(gate_replace old new)
    string(FIND "${gate}" "${old}" found)
    if(found LESS 0)
      message(FATAL_ERROR "Gate measurement adapter no longer matches: ${old}")
    endif()
    string(REPLACE "${old}" "${new}" gate "${gate}")
    set(gate "${gate}" PARENT_SCOPE)
  endfunction()
  gate_replace("#include \"e1_platform.h\"" "#include \"e1_platform.h\"\n#include \"gate_counters.h\"")
  gate_replace("double layout_ms,render_ms,total_ms,reference_ms;" "double layout_ms,render_ms,total_ms,reference_ms;gate_sample work;")
  gate_replace("if(!e1_pin()) return 3;" "if(!e1_pin()) return 3;gate_init();")
  gate_replace("(void)perf_reference_ms();" "/* No reference calibration in the direct cycle gate. */")
  gate_replace("item->reference_ms=perf_reference_ms();" "item->reference_ms=gate_begin(&item->work);")
  gate_replace("item->layout_ms=now_ms()-at;" "item->work.layout_end=gate_read();item->layout_ms=gate_delta(item->work.start,item->work.layout_end).wall_ms;")
  gate_replace("if(!layout) return 2;" "if(!layout) { item->work.transition=gate_add(item->work.transition,gate_delta(item->work.start,item->work.layout_end));return 2; }")
  gate_replace("at=now_ms();if(!create_pager(publication,part,font,0,&pager,&error)) goto finish;"
    "gate_stamp transition_start=gate_read();at=now_ms();if(!create_pager(publication,part,font,0,&pager,&error)) goto finish;")
  gate_replace("transition+=now_ms()-at;current_part=part;page=0;"
    "gate_stamp transition_work=gate_delta(transition_start,gate_read());transition+=transition_work.wall_ms;samples[count].work.transition=gate_add(samples[count].work.transition,transition_work);current_part=part;page=0;")
  gate_replace("item->render_ms=item->total_ms=now_ms()-at;" "gate_end(&item->work);item->render_ms=item->total_ms=gate_delta(item->work.start,item->work.end).wall_ms;")
  gate_replace("item->render_ms=now_ms()-at;item->total_ms=item->layout_ms+item->render_ms;" "gate_end(&item->work);item->render_ms=gate_delta(item->work.layout_end,item->work.end).wall_ms;item->total_ms=item->layout_ms+item->render_ms;")
  gate_replace("\\\"explicit_snapshot_bytes\\\":%zu}" "\\\"explicit_snapshot_bytes\\\":%zu")
  gate_replace("m->page_cache_bytes,m->checkpoint_bytes,m->explicit_snapshot_bytes);" "m->page_cache_bytes,m->checkpoint_bytes,m->explicit_snapshot_bytes);gate_print(&s->work);")
  file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/gate_probe.c" "${gate}")
  add_executable(gate-probe "${CMAKE_CURRENT_BINARY_DIR}/gate_probe.c")
  target_include_directories(gate-probe PRIVATE "${CMAKE_CURRENT_LIST_DIR}")
  target_link_libraries(gate-probe PRIVATE exreader)
  if(WIN32)
    target_link_libraries(gate-probe PRIVATE psapi)
    if(MINGW)
      target_link_options(gate-probe PRIVATE "-Wl,--no-insert-timestamp")
    endif()
    if(EXR_BUILD_SHARED_COMPAT)
      add_custom_command(TARGET gate-probe POST_BUILD COMMAND ${CMAKE_COMMAND} -E copy_if_different
        "$<TARGET_FILE:exreader>" "$<TARGET_FILE_DIR:gate-probe>")
    endif()
  else()
    target_compile_definitions(gate-probe PRIVATE _GNU_SOURCE)
    target_link_libraries(gate-probe PRIVATE m)
  endif()
endif()
