@@ -622,0 +623,167 @@ static int bilinear_axis(exr_bitmap *target,const exr_bitmap *source,const doubl
+/* A one-level soft or shape mask sampled at the color sample's coordinate,
+   as texture_sample does: the same nearest index or bilinear tap, then the
+   same mask factor. Columns are tabulated once per image, rows once per row. */
+typedef struct { const exr_bitmap *bitmap; int interpolate; unsigned mode; image_tap *columns; } axis_mask;
+static inline double resample_mask_factor(const axis_mask *m,const unsigned char *row0,const unsigned char *row1,
+                                      image_tap column,double wy) {
+  double out[4];
+  if(m->interpolate) bilinear_sample(row0,row1,column,wy,out);
+  else { const unsigned char *p=row0+column.first*4; out[3]=p[3]; out[0]=p[0]*out[3]; }
+  return (m->mode==1 ? out[0]/255 : out[3])/255;
+}
+static void axis_mask_rows(const axis_mask *m,double v,const unsigned char *rows[2],double *wy) {
+  const exr_bitmap *b=m->bitmap;
+  if(m->interpolate) {
+    image_tap tap=bilinear_tap(v,b->height);
+    rows[0]=b->pixels+(size_t)tap.first*b->stride;rows[1]=b->pixels+(size_t)tap.second*b->stride;*wy=tap.fraction;
+  } else {
+    uint32_t y=(uint32_t)(v*b->height); if(y>=b->height) y=b->height-1;
+    rows[0]=rows[1]=b->pixels+(size_t)y*b->stride;*wy=0;
+  }
+}
+/* The separable transform gives each column the same two horizontal taps
+   on every row. Keep the generic tap, weight and summation order. A mask
+   factor multiplies each color sample before it joins the pixel sums, in
+   texture_sample's order. */
+static int masked_bilinear_axis(exr_bitmap *target,const exr_vector_texture *texture,const double inv[6],double alpha,
+                         const exr_bitmap *clip,int x0,int y0,int x1,int y1,size_t cost,
+                         size_t *work,const exr_control *control,exr_error *e,exr_status *result) {
+  const exr_bitmap *source=&texture->bitmap;
+  axis_mask mask_layer={0},*layer_mask=NULL;
+  if(inv[1] || inv[2] || x1<=x0 || y1<=y0) return 0;
+  double x_first=inv[0]*(x0+.25)+inv[2]*(y0+.25)+inv[4],x_last=inv[0]*(x1-.25)+inv[2]*(y0+.25)+inv[4];
+  double y_first=inv[1]*(x0+.25)+inv[3]*(y0+.25)+inv[5],y_last=inv[1]*(x0+.25)+inv[3]*(y1-.25)+inv[5];
+  if(!isfinite(x_first) || !isfinite(x_last) || !isfinite(y_first) || !isfinite(y_last)) return 0;
+  size_t width=(size_t)(x1-x0);
+  image_tap *columns=malloc((texture->mask ? 4 : 2)*width*sizeof(*columns));
+  if(!columns) return 0;
+  if(texture->mask) {
+    mask_layer=(axis_mask){&texture->mask->bitmap,(int)texture->mask->interpolate,texture->mask_mode,columns+2*width};
+    layer_mask=&mask_layer;
+  }
+  unsigned lo=source->width,hi=0;
+  for(size_t i=0;i<2*width;i++) {
+    double px=(x0+(int)(i>>1))+.25+.5*(i&1);
+    double u=inv[0]*px+inv[2]*(y0+.25)+inv[4];
+    columns[i]=u<0 || u>=1 ? (image_tap){0,-1,-1} : bilinear_tap(u,source->width);
+    if(layer_mask && columns[i].first>=0) {
+      if(layer_mask->interpolate) layer_mask->columns[i]=bilinear_tap(u,layer_mask->bitmap->width);
+      else {
+        uint32_t t=(uint32_t)(u*layer_mask->bitmap->width);
+        layer_mask->columns[i]=(image_tap){0,(int)(t>=layer_mask->bitmap->width ? layer_mask->bitmap->width-1 : t),0};
+      }
+    }
+    if(columns[i].first>=0) {
+      if((unsigned)columns[i].first<lo) lo=(unsigned)columns[i].first;
+      if((unsigned)columns[i].first+1>hi) hi=(unsigned)columns[i].first+1;
+    }
+  }
+#if defined(__SSE2__) || defined(_M_X64)
+  /* Convert each source row once when the used span is comparable to the
+     destination width; strong minification keeps per-tap conversion. */
+  double *storage_rows=lo<=hi && (size_t)(hi-lo)<=4*width ? malloc(4*5*(size_t)(hi-lo+1)*sizeof(double)) : NULL;
+  if(storage_rows) {
+    converted_row slots[4];size_t span=(size_t)(hi-lo+1);
+    for(unsigned s=0;s<4;s++) { slots[s].row=-1;slots[s].rgb1=storage_rows+s*5*span;slots[s].alpha=slots[s].rgb1+4*span; }
+    for(int y=y0;y<y1;y++) {
+      *result=exr_control_cancel(control,e);
+      if(*result!=EXR_OK) break;
+      if(!exr_vector_work(work,width*cost)) {
+        *result=exr_fail(e,EXR_LIMIT,"Affine image work budget exceeded");break;
+      }
+      const unsigned char *mask=clip ? clip->pixels+(size_t)y*clip->stride : NULL;
+      image_tap taps[2];int valid[2]={0,0},need[4];unsigned count=0;
+      const converted_row *rows[2][2]={{NULL,NULL},{NULL,NULL}};__m128d wy[2][2];
+      const unsigned char *mask_rows[2][2]={{NULL,NULL},{NULL,NULL}};double mask_wy[2]={0,0};
+      for(unsigned sy=0;sy<2;sy++) {
+        double py=y+.25+.5*sy,v=inv[1]*(x0+.25)+inv[3]*py+inv[5];
+        if(v<0 || v>=1) continue;
+        taps[sy]=bilinear_tap(v,source->height);valid[sy]=1;
+        need[count++]=taps[sy].first;need[count++]=taps[sy].second;
+        if(layer_mask) axis_mask_rows(layer_mask,v,mask_rows[sy],mask_wy+sy);
+      }
+      if(!count) continue;
+      for(unsigned sy=0;sy<2;sy++) if(valid[sy]) {
+        double fraction=taps[sy].fraction;
+        rows[sy][0]=find_row(slots,need,count,taps[sy].first,source,lo,hi);
+        rows[sy][1]=find_row(slots,need,count,taps[sy].second,source,lo,hi);
+        wy[sy][0]=_mm_set1_pd(1-fraction);wy[sy][1]=_mm_set1_pd(fraction);
+      }
+      for(int x=x0;x<x1;x++) {
+        unsigned coverage=mask ? mask[x] : 255;
+        const image_tap *column=columns+2*(size_t)(x-x0);
+        __m128d rg=_mm_setzero_pd(),ba=_mm_setzero_pd();double sums[4];
+        if(!coverage) continue;
+        for(unsigned sy=0;sy<2;sy++) if(valid[sy]) {
+          for(unsigned sx=0;sx<2;sx++) if(column[sx].first>=0) {
+            double fraction=column[sx].fraction;
+            if(!layer_mask) converted_sample(rows[sy][0],rows[sy][1],(size_t)(column[sx].first-(int)lo),
+              _mm_set_pd(fraction,1-fraction),wy[sy][0],wy[sy][1],&rg,&ba);
+            else {
+              __m128d sample_rg=_mm_setzero_pd(),sample_ba=_mm_setzero_pd(),factor;
+              converted_sample(rows[sy][0],rows[sy][1],(size_t)(column[sx].first-(int)lo),
+                _mm_set_pd(fraction,1-fraction),wy[sy][0],wy[sy][1],&sample_rg,&sample_ba);
+              factor=_mm_set1_pd(resample_mask_factor(layer_mask,mask_rows[sy][0],mask_rows[sy][1],
+                layer_mask->columns[2*(size_t)(x-x0)+sx],mask_wy[sy]));
+              rg=_mm_add_pd(rg,_mm_mul_pd(sample_rg,factor));ba=_mm_add_pd(ba,_mm_mul_pd(sample_ba,factor));
+            }
+          }
+        }
+        _mm_storeu_pd(sums,rg);_mm_storeu_pd(sums+2,ba);
+        if(!sums[3]) continue;
+        uint32_t color=image_byte(sums[3]*alpha/4);
+        for(unsigned k=0;k<3;k++) color|=image_byte(sums[k]/sums[3])<<(24-8*k);
+        exr_pixel(target,x,y,color,coverage);
+      }
+    }
+    free(storage_rows);free(columns);
+    if(*result==EXR_OK) *result=exr_fail(e,EXR_OK,"");
+    return 1;
+  }
+#endif
+  for(int y=y0;y<y1;y++) {
+    *result=exr_control_cancel(control,e);
+    if(*result!=EXR_OK) break;
+    if(!exr_vector_work(work,width*cost)) {
+      *result=exr_fail(e,EXR_LIMIT,"Affine image work budget exceeded");break;
+    }
+    const unsigned char *mask=clip ? clip->pixels+(size_t)y*clip->stride : NULL;
+    const unsigned char *rows[2][2]={{NULL,NULL},{NULL,NULL}},*mask_rows[2][2]={{NULL,NULL},{NULL,NULL}};
+    double wy[2]={0,0},mask_wy[2]={0,0};
+    for(unsigned sy=0;sy<2;sy++) {
+      double py=y+.25+.5*sy,v=inv[1]*(x0+.25)+inv[3]*py+inv[5];
+      if(v<0 || v>=1) continue;
+      image_tap tap=bilinear_tap(v,source->height);
+      rows[sy][0]=source->pixels+(size_t)tap.first*source->stride;
+      rows[sy][1]=source->pixels+(size_t)tap.second*source->stride;
+      wy[sy]=tap.fraction;
+      if(layer_mask) axis_mask_rows(layer_mask,v,mask_rows[sy],mask_wy+sy);
+    }
+    for(int x=x0;x<x1;x++) {
+      unsigned coverage=mask ? mask[x] : 255;
+      const image_tap *taps=columns+2*(size_t)(x-x0);
+      double sums[4]={0};
+      if(!coverage) continue;
+      for(unsigned sy=0;sy<2;sy++) if(rows[sy][0]) {
+        for(unsigned sx=0;sx<2;sx++) if(taps[sx].first>=0) {
+          double rgba[4];
+          bilinear_sample(rows[sy][0],rows[sy][1],taps[sx],wy[sy],rgba);
+          if(layer_mask) {
+            double a=resample_mask_factor(layer_mask,mask_rows[sy][0],mask_rows[sy][1],layer_mask->columns[2*(size_t)(x-x0)+sx],mask_wy[sy]);
+            for(unsigned k=0;k<3;k++) rgba[k]*=a;
+            rgba[3]*=a;
+          }
+          for(unsigned k=0;k<4;k++) sums[k]+=rgba[k];
+        }
+      }
+      if(!sums[3]) continue;
+      uint32_t color=image_byte(sums[3]*alpha/4);
+      for(unsigned k=0;k<3;k++) color|=image_byte(sums[k]/sums[3])<<(24-8*k);
+      exr_pixel(target,x,y,color,coverage);
+    }
+  }
+  free(columns);
+  if(*result==EXR_OK) *result=exr_fail(e,EXR_OK,"");
+  return 1;
+}
+
