@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
if(NOT WIN32 AND NOT ANDROID)
  if(NOT @EXR_WEBDAV_APPLE_URLSESSION@)
    find_dependency(Threads)
    find_dependency(PkgConfig)
    pkg_check_modules(CURL REQUIRED IMPORTED_TARGET libcurl)
  endif()
  find_dependency(LibXml2)
endif()
if(@EXR_WEBDAV_MANAGED@)
  find_dependency(EXReaderWebDAVCleanup 0.1.0 EXACT CONFIG)
endif()
include("${CMAKE_CURRENT_LIST_DIR}/EXReaderWebDAVTargets.cmake")
