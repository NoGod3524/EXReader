@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
get_filename_component(_observed_webdav_dir "${CMAKE_CURRENT_LIST_DIR}/../EXReaderWebDAV" REALPATH)
if(TARGET EXReaderWebDAV::exr_webdav)
  get_filename_component(_observed_existing_dir "${EXReaderWebDAV_DIR}" REALPATH)
  if(NOT _observed_existing_dir STREQUAL _observed_webdav_dir)
    message(FATAL_ERROR "Observed capability and loaded WebDAV package must come from the same installation")
  endif()
endif()
find_dependency(EXReaderWebDAV 0.2.0 EXACT CONFIG PATHS "${_observed_webdav_dir}" NO_DEFAULT_PATH)
get_filename_component(_observed_loaded_dir "${EXReaderWebDAV_DIR}" REALPATH)
if(NOT _observed_loaded_dir STREQUAL _observed_webdav_dir)
  message(FATAL_ERROR "Observed capability and WebDAV package must come from the same installation")
endif()
